# Copie para .env e preencha localmente. NUNCA versione o .env.
# A credencial de afiliado deve ser registrada como SEGREDO no Paperclip e
# injetada como variavel de ambiente (ML_AFFILIATE_TAG) em runtime.

PORT=3000
HOST=127.0.0.1
SITE_NAME=Achados de Moda & Beleza
BASE_URL=http://localhost:3000

# Segredo de afiliado (ex.: tag fornecida pelo programa de afiliados do Mercado Livre).
ML_AFFILIATE_TAG=
# Nome do parametro de rastreamento usado no link (confirmar com o programa ativo).
ML_AFFILIATE_PARAM=matt_word

# Salt para anonimizar IP/User-Agent dos cliques registrados.
CLICK_HASH_SALT=

# Caminho opcional do arquivo de cliques (JSONL).
# CLICKS_FILE=./data/clicks.jsonl
